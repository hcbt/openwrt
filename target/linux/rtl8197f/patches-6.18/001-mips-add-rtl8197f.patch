mips: add a little-endian RTL8197F machine

24Kc only. No GIC and no InterAptiv. Endian is little only, so this
cannot share the big-endian realtek switch-SoC toolchain.

---
 arch/mips/Kbuild.platforms |  1 +
 arch/mips/Kconfig          | 18 ++++++++++++++++++
 2 files changed, 19 insertions(+)

--- a/arch/mips/Kconfig
+++ b/arch/mips/Kconfig
@@ -414,6 +414,24 @@ config ECONET
 	  Don't confuse these with the Airoha ARM devices sometimes referred
 	  to as "EcoNet", this family is for MIPS based devices only.
 
+config MACH_RTL8197F
+	bool "Realtek RTL8197F"
+	select CEVT_R4K
+	select CPU_LITTLE_ENDIAN
+	select CSRC_R4K
+	select DMA_NONCOHERENT
+	select IRQ_MIPS_CPU
+	select MIPS_L1_CACHE_SHIFT_5
+	select SYS_HAS_CPU_MIPS32_R2
+	select SYS_SUPPORTS_32BIT_KERNEL
+	select SYS_SUPPORTS_LITTLE_ENDIAN
+	select SYS_SUPPORTS_MIPS16
+	select USE_OF
+	help
+	  Support for little-endian Realtek RTL8197F boards. The CPU is a
+	  MIPS 24Kc. This is not the big-endian RTL83xx/RTL93xx/RTL960x
+	  switch SoC, and it has no GIC.
+
 config MACH_JAZZ
 	bool "Jazz family of machines"
 	select ARC_MEMORY
--- a/arch/mips/Kbuild.platforms
+++ b/arch/mips/Kbuild.platforms
@@ -23,6 +23,7 @@ platform-$(CONFIG_PIC32MZDA)		+= pic32/
 platform-$(CONFIG_PIC32MZDA)		+= pic32/
 platform-$(CONFIG_RALINK)		+= ralink/
+platform-$(CONFIG_MACH_RTL8197F)	+= rtl8197f/
 platform-$(CONFIG_MIKROTIK_RB532)	+= rb532/
 platform-$(CONFIG_SGI_IP22)		+= sgi-ip22/
 platform-$(CONFIG_SGI_IP27)		+= sgi-ip27/
 platform-$(CONFIG_SGI_IP28)		+= sgi-ip22/
